# Placeholder-only environment contract for the Student Telemetry Harness.
# `install.mjs` provisions the fixed URL/token in the ignored `.env`.
# Luna/Codex chooses the app key/name once it understands the app, then writes
# them through `.codex/hooks/set-app-identity.mjs`.

TEAM_TELEMETRY_API_URL=https://wonik90-telemetry-api.azurewebsites.net/api/v1/records
TEAM_TELEMETRY_TOKEN=
TEAM_TELEMETRY_APP_KEY=
TEAM_TELEMETRY_APP_NAME=

# Server-side only. Never commit the real value.
OPENAI_API_KEY=
# Optional: defaults to the model available to the configured API project.
OPENAI_MODEL=
